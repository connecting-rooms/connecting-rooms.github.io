---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <a class="footer-brand" href="/">Connecting Rooms</a>
      <p>Connecting Rooms is building a calm coordination layer for the moments around a shared session: why the room exists, who is participating, what needs attention, and what should happen next.</p>
    </div>
    <nav aria-label="Product links">
      <strong>Explore</strong>
      <a href="/product/">Product</a>
      <a href="/trust/">Trust</a>
      <a href="/about/">About</a>
    </nav>
    <nav aria-label="Account links">
      <strong>Access</strong>
      <a href={site.userUrl}>User login</a>
      <a href={site.orgUrl}>Organization login</a>
      <a href={site.authUrl}>Create account</a>
    </nav>
    <nav aria-label="Project links">
      <strong>Project</strong>
      <a href={site.githubUrl}>GitHub organization</a>
      <a href={`https://github.com/connecting-rooms/connecting-rooms.github.io`}>Site source</a>
    </nav>
  </div>
  <div class="footer-base">
    <span>© 2026 Connecting Rooms</span>
    <span>Built with Astro · Static by design</span>
  </div>
</footer>
